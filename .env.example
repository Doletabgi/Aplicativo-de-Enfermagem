# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha com suas próprias credenciais locais.
# NUNCA envie ou comite seu arquivo .env com chaves reais para o repositório público.
# ==============================================================================

# Chave de API Groq (Opcional - Usada pelo assistente de IA clínica online)
# Obtenha gratuitamente em: https://console.groq.com
GROQ_API_KEY=sua_chave_groq_aqui

# Chave de API Gemini (Opcional - Fallback no groq-proxy)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Credenciais de Administrador Inicial
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=sua_senha_segura_aqui
ADMIN_NAME=Administrador
